generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int          @id @default(autoincrement())
  email          String       @unique
  passwordHash   String
  name           String
  role           String       // "admin" | "student"
  status         String       @default("Active") // Active | Pending | Suspended
  membershipTier String       @default("Free") // Free | Community
  coursesCount   Int          @default(0)
  joinedAt       DateTime     @default(now())
  country        String?
  phone          String?
  telegramId     String?
  whatsappNumber String?
  signalsAccess  Boolean      @default(false)
  signalsExpiresAt DateTime?
  membershipExpiresAt DateTime? // Community membership is $10/month; renewal reminders fire as this approaches/passes
  lastMembershipReminderAt DateTime? // throttles reminder emails to at most one every few days
  resetToken     String?      @unique // forgot-password flow; single-use, cleared on success
  resetTokenExpiresAt DateTime?
  paypalSubscriptionId String? @unique // the active Community Membership subscription, if any
  aiTradeConnected Boolean    @default(false)
  aiTradeUndertakingAcceptedAt DateTime?
  payments       Payment[]
  enrollments    Enrollment[]
  signalProofs   SignalProof[]
  certificates   Certificate[]
  aiTradeRequests AiTradeRequest[]
  vipBookings    VipBooking[]
  testimonials   Testimonial[]
}

model Course {
  id             Int          @id @default(autoincrement())
  name           String
  category       String
  price          String
  students       Int          @default(0)
  status         String       @default("Draft") // Published | Draft
  isCurrentBatch Boolean      @default(false)
  lessons        Lesson[]
  enrollments    Enrollment[]
  payments       Payment[]
}

model Enrollment {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId   Int
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress   Int      @default(0)
  completed  Boolean  @default(false)
  source     String   // "membership" | "purchase"
  enrolledAt DateTime @default(now())

  @@unique([userId, courseId])
}

model Lesson {
  id       Int    @id @default(autoincrement())
  courseId Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title    String
  videoUrl String // YouTube (unlisted/private) link — no server-side video storage
  duration String @default("—")
}

model LiveClass {
  id        Int    @id @default(autoincrement())
  title     String
  when      String
  platform  String
  attendees Int    @default(0)
}

model Announcement {
  id       Int      @id @default(autoincrement())
  title    String
  message  String   @default("")
  audience String
  sentAt   DateTime @default(now())
}

model Payment {
  id       Int      @id @default(autoincrement())
  student  String
  course   String
  method   String
  amount   String
  status   String   // Paid | Pending | Refunded
  date     DateTime @default(now())
  userId   Int?
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  courseId Int?
  courseRef Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  proofUrl  String?
  reference String?
}

model PaymentMethod {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  instructions String
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
}

model SignalProof {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  broker      String
  amount      String
  proofUrl    String?
  status      String   @default("Pending") // Pending | Approved | Rejected
  submittedAt DateTime @default(now())
}

model AiTradeRequest {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  broker        String   // "PU Prime" | "Exness"
  accountType   String   @default("Cent / USDC-Cent")
  accountNumber String
  amount        String
  undertakingAccepted Boolean @default(false)
  status        String   @default("Pending") // Pending | Approved | Connected | Rejected
  submittedAt   DateTime @default(now())
}

model VipBooking {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestedAt DateTime // the date/time slot the student picked
  notes       String?
  status      String   @default("Pending") // Pending | Confirmed | Cancelled
  createdAt   DateTime @default(now())
}

model Testimonial {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text       String
  rating     Int      @default(5) // 1-5
  status     String   @default("Pending") // Pending | Approved | Rejected
  createdAt  DateTime @default(now())
}

model Resource {
  id         Int      @id @default(autoincrement())
  name       String
  type       String
  tier       String   // Silver | Gold | Platinum
  version    String   @default("v1.0")
  fileName   String
  filePath   String
  size       String
  uploadedAt DateTime @default(now())
}

model Certificate {
  id                Int      @id @default(autoincrement())
  userId            Int
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentName       String
  programName       String
  batchName         String
  completionDate    String
  certificateNumber String   @unique
  issuedAt          DateTime @default(now())
}

model Broker {
  id         Int    @id @default(autoincrement())
  name       String
  clicks     Int    @default(0)
  regs       Int    @default(0)
  conv       String @default("0%")
  commission Int    @default(0)
  status     String @default("Active")
}

model Ticket {
  id      Int    @id @default(autoincrement())
  student String
  subject String
  status  String @default("Open") // Open | Resolved
  date    DateTime @default(now())
}

model BlogPost {
  id              Int      @id @default(autoincrement())
  slug            String   @unique
  title           String
  excerpt         String
  content         String   // plain text; blank-line-separated paragraphs, rendered as HTML on the public page
  metaDescription String
  authorName      String   @default("Forex Money Machine Academy")
  published       Boolean  @default(false)
  publishedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Singleton (fixed id: 1) — every number on the admin Analytics panel is
// manually entered and manually reset by the admin, not computed from real
// data. This intentionally replaced a mix of live-computed figures (revenue,
// broker commission) and outright fabricated placeholder numbers (student
// count, sales chart, traffic sources) that were hardcoded in the dashboard
// with no backing data source at all.
model AnalyticsSettings {
  id                    Int      @id @default(autoincrement())
  totalRevenue          String   @default("$0")
  revenueDelta          String   @default("")
  totalStudents         String   @default("0")
  studentsDelta         String   @default("")
  certificatesIssued    String   @default("0")
  certificatesDelta     String   @default("")
  brokerCommission      String   @default("$0")
  brokerCommissionDelta String   @default("")
  conversionRate        String   @default("0%")
  monthlySales          Json     @default("[]")
  trafficSources        Json     @default("[]")
  updatedAt             DateTime @updatedAt
}

// Holds checkout details (VIP notes, course choice) across the PayPal
// redirect for one-time Orders — PayPal's custom_id field caps at 127 chars,
// too small for free-text notes, so we stash the row id there instead and
// look the rest up on capture. Consumed (deleted) once captured.
model PendingCheckout {
  id          Int      @id @default(autoincrement())
  userId      Int
  kind        String   // "course" | "vip"
  courseId    Int?
  requestedAt DateTime?
  notes       String?
  createdAt   DateTime @default(now())
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  text      String
  createdAt DateTime @default(now())
}
