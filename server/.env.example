DATABASE_URL="postgresql://user:password@host:5432/dbname"
JWT_SECRET="replace-with-a-long-random-string"
PORT=4000
# Optional: point video uploads at a mounted persistent volume in production
# UPLOADS_DIR=/data/uploads

# Required for live homepage quotes (forex/gold/indices) and the XAU/USD signal
# engine. Free tier at https://twelvedata.com — without it, quotes show "—" and
# the signal endpoint returns an explicit "no data" error instead of a fake signal.
# TWELVE_DATA_API_KEY=

# PayPal — Community Membership + course installment subscriptions, and
# one-time course/VIP payments. Use sandbox credentials until the flow is
# verified end to end, then switch PAYPAL_MODE to "live".
# PAYPAL_MODE=sandbox
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_MEMBERSHIP_PLAN_ID=  (run scripts/setup-paypal-membership.js to create it)
# PAYPAL_COURSE_INSTALLMENT_PLAN_ID=  (run scripts/setup-paypal-course-installment.js to create it)
# PAYPAL_WEBHOOK_ID=  (run scripts/setup-paypal-webhook.js to create it)
