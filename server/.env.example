DATABASE_URL="postgresql://user:password@host:5432/dbname"
JWT_SECRET="replace-with-a-long-random-string"
PORT=4000
# Optional: point video uploads at a mounted persistent volume in production
# UPLOADS_DIR=/data/uploads

# Required for live homepage quotes (forex/gold/indices) and the XAU/USD signal
# engine. Free tier at https://twelvedata.com — without it, quotes show "—" and
# the signal endpoint returns an explicit "no data" error instead of a fake signal.
# TWELVE_DATA_API_KEY=

# Stripe — Community Membership subscription checkout + webhook fulfillment.
# Use test-mode keys (sk_test_...) until the flow is verified end to end.
# STRIPE_SECRET_KEY=
# STRIPE_MEMBERSHIP_PRICE_ID=  (run scripts/setup-stripe-membership.js to create it)
# STRIPE_WEBHOOK_SECRET=  (run scripts/setup-stripe-webhook.js to create it)
